&НаСервере
Процедура ВыполнитьЗадание2НаСервере()
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	МассивДанные = ЗначениеИзСтрокиВнутр(ОбъектОбработка.ПолучитьМакет("МакетЗадание2").ПолучитьТекст());
	//Старт
	
	// 1. Максимальная длина
	МаксКоличество = 0;
	Для Каждого ФиксМассив Из МассивДанные Цикл
		МаксКоличество = Макс(МаксКоличество, ФиксМассив.Количество());
	КонецЦикла;
	
	// ⭐ ПО СТАТЬЕ: берём дерево из реквизита формы!
	ДеревоРек = РеквизитФормыВЗначение("Задание2Дерево");
	ДеревоРек.Строки.Очистить();
	
	НомерМассива = 0;
	
	Для Каждого ФиксМассив Из МассивДанные Цикл
		Массив = Новый Массив;
		Для Каждого ЭлементИзМакета Из ФиксМассив Цикл
			Массив.Добавить(ЭлементИзМакета);
		КонецЦикла;
		НомерМассива = НомерМассива + 1;
		
		Если Массив.Количество() > 1 Тогда
			Интервал = Массив[Массив.Количество() - 1].Дата - Массив[Массив.Количество() - 2].Дата;
		Иначе
			Интервал = 86400;
		КонецЕсли;
		
		Пока Массив.Количество() < МаксКоличество Цикл
			НоваяДата = Массив[Массив.Количество() - 1].Дата + Интервал;
			Массив.Добавить(Новый Структура("Дата, Представление",
				НоваяДата, Формат(НоваяДата, "ДФ='d MMMM yyyy'")));
		КонецЦикла;
		
		// ⭐ УЗЕЛ (родитель) — через Строки.Добавить()!
		Родитель = ДеревоРек.Строки.Добавить();
		Родитель.Представление = "Массив " + НомерМассива;
		
		// ⭐ ПОДЧИНЁННЫЕ (дети) — у родителя тоже Свои Строки!
		Для Каждого ЭлементМассива Из Массив Цикл
			СтрокаДерева = Родитель.Строки.Добавить();
			СтрокаДерева.Дата = ЭлементМассива.Дата;
			СтрокаДерева.Представление = ЭлементМассива.Представление;
		КонецЦикла;
	КонецЦикла;
	
	// ⭐ ПО СТАТЬЕ: возвращаем дерево в реквизит формы!
	ЗначениеВРеквизитФормы(ДеревоРек, "Задание2Дерево");
	
	Сообщить("ГОТОВО! Массивов в дереве: " + ДеревоРек.Строки.Количество());
	//Финиш
КонецПроцедуры
