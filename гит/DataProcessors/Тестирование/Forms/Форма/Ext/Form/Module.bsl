&НаКлиенте
Процедура ВыполнитьЗадание3(Команда)
	ЗаполнитьИсходнуюТаблицу3НаСервере();
	МассивПродавцов = ПолучитьТопПродавцовНаСервере();
	ПараметрыФормы = Новый Структура("Продавцы", МассивПродавцов);
	ОткрытьФорму(
		"Обработка.Тестирование.Форма.ФормаВыбораПродавца",
		ПараметрыФормы, ЭтаФорма, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораЗначения(ВыбранноеЗначение, ИсточникВыбора)
	Продавец = Неопределено;
	Попытка
		Продавец = ВыбранноеЗначение.Продавец;
	Исключение
		Продавец = Неопределено;
	КонецПопытки;
	
	Если Продавец <> Неопределено Тогда
		ОтфильтроватьПоПродавцуНаСервере(Продавец);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОповещении(ИмяСобытия, Параметр, Источник)
	// Приём оповещения от формы выбора — фильтрация по продавцу
	Если ИмяСобытия = "ВыборПродавца" 
		И ТипЗнч(Параметр) = Тип("Структура") Тогда
		Продавец = Неопределено;
		Если Параметр.Свойство("Продавец", Продавец) И Продавец <> Неопределено Тогда
			ОтфильтроватьПоПродавцуНаСервере(Продавец);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтфильтроватьПоПродавцу(Знач Продавец) Экспорт
	ОтфильтроватьПоПродавцуНаСервере(Продавец);
КонецПроцедуры