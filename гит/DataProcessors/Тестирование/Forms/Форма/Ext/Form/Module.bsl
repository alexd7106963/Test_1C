&НаСервере
Процедура ВыполнитьЗадание1НаСервере()
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");                           
	тзДанные = ЗначениеИзСтрокиВнутр(ОбъектОбработка.ПолучитьМакет("МакетЗадание1").ПолучитьТекст()); 
	ТаблицаЗаданиеИсходная1.Загрузить(тзДанные);
	//Старт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Данные.Код КАК Код,
	|	Данные.Наименование КАК Наименование,
	|	Данные.Период КАК Период,
	|	Данные.Цена КАК Цена
	|ПОМЕСТИТЬ ВТИсходная
	|ИЗ
	|	&Исходная КАК Данные
	|;
	|
	|ВЫБРАТЬ
	|	ВТИсходная.Код КАК Код,
	|	ВТИсходная.Наименование КАК Наименование,
	|	ВТИсходная.Период КАК Период,
	|	ВТИсходная.Цена КАК Цена
	|ИЗ
	|	ВТИсходная КАК ВТИсходная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				ВТИсходная.Код КАК Код,
	|				МАКСИМУМ(ВТИсходная.Период) КАК МаксПериод
	|			ИЗ
	|				ВТИсходная КАК ВТИсходная
	|			СГРУППИРОВАТЬ ПО
	|				ВТИсходная.Код
	|		) КАК Последняя
	|		ПО ВТИсходная.Код = Последняя.Код
	|			И ВТИсходная.Период = Последняя.МаксПериод";
	
	Запрос.УстановитьПараметр("Исходная", тзДанные);
	ТаблицаЗаданиеРезультат1.Загрузить(Запрос.Выполнить().Выгрузить());
	
	//Финиш
КонецПроцедуры

