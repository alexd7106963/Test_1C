&НаСервере
Функция ПолучитьТопПродавцовНаСервере()
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	тзДанные = ЗначениеИзСтрокиВнутр(ОбъектОбработка.ПолучитьМакет("МакетЗадание3").ПолучитьТекст());
	
	// Собираем уникальные товары по каждому продавцу
	ТоварыПоПродавцам = Новый Соответствие;
	Для Каждого Строка Из тзДанные Цикл
		Набор = ТоварыПоПродавцам.Получить(Строка.Продавец);
		Если Набор = Неопределено Тогда
			Набор = Новый Соответствие;
			ТоварыПоПродавцам.Вставить(Строка.Продавец, Набор);
		КонецЕсли;
		Набор.Вставить(Строка.Наименование, Истина);
	КонецЦикла;
	
	// Строим таблицу «Продавец + Количество цен»
	ТопПродавцы = Новый ТаблицаЗначений;
	ТопПродавцы.Колонки.Добавить("Продавец");
	ТопПродавцы.Колонки.Добавить("КоличествоЦен");
	
	Для Каждого КлючИЗначение Из ТоварыПоПродавцам Цикл
		НоваяСтрока = ТопПродавцы.Добавить();
		НоваяСтрока.Продавец = КлючИЗначение.Ключ;
		НоваяСтрока.КоличествоЦен = КлючИЗначение.Значение.Количество();
	КонецЦикла;
	
	// Сортируем по убыванию и оставляем первые 10
	ТопПродавцы.Сортировать("КоличествоЦен Убыв");
	
	Пока ТопПродавцы.Количество() > 10 Цикл
		ТопПродавцы.Удалить(ТопПродавцы.Количество() - 1);
	КонецЦикла;
	
	// Превращаем в МАССИВ структур — безопасно переходит границу клиент-сервер
	МассивПродавцов = Новый Массив;
	Для Каждого Строка Из ТопПродавцы Цикл
		МассивПродавцов.Добавить(Новый Структура("Продавец, КоличествоЦен",
			Строка.Продавец, Строка.КоличествоЦен));
	КонецЦикла;
	
	Возврат МассивПродавцов;
КонецФункции

&НаСервере
Процедура ОтфильтроватьПоПродавцуНаСервере(Знач Продавец)
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	тзДанные = ЗначениеИзСтрокиВнутр(ОбъектОбработка.ПолучитьМакет("МакетЗадание3").ПолучитьТекст());
	Строки = тзДанные.НайтиСтроки(Новый Структура("Продавец", Продавец));
	ТаблицаЗаданиеИсходная3.Загрузить(тзДанные.Скопировать(Строки));
КонецПроцедуры

